# Copy to .env and replace every value. Never commit .env or production secrets.
NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1,https://localhost,https://127.0.0.1
COOKIE_SECURE=false
TRUST_PROXY=true
DEMO_ACCOUNTS_ENABLED=false
VITE_SHOW_DEMO_CREDENTIALS=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mama_auto_parts_db
DB_USER=mama_app
DB_PASSWORD=replace-with-a-database-password
DB_ADMIN_USER=mama_setup
DB_ADMIN_PASSWORD=replace-with-a-provisioning-database-password

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes
